{
  "name": "quantweave-backtest",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.13.0"
  },
  "scripts": {
    "dev": "scripts/run_backtest_stack.sh dev",
    "dev:web": "next dev --webpack -H 127.0.0.1 -p 3100",
    "build": "zsh scripts/run_next_build.sh",
    "start": "scripts/run_backtest_stack.sh start",
    "start:web": "next start -H 127.0.0.1 -p 3100",
    "typecheck": "zsh scripts/run_next_typecheck.sh",
    "lint": "eslint . --ignore-pattern .next",
    "api:start": "scripts/run_qmt_service.sh",
    "lab:start": "scripts/run_backtest_lab.sh",
    "data:update": ".venv/bin/python scripts/update_market_data.py",
    "data:update:dry-run": ".venv/bin/python scripts/update_market_data.py --dry-run",
    "data:scheduler": ".venv/bin/python scripts/data_scheduler.py",
    "data:scheduler:dry-run": ".venv/bin/python scripts/data_scheduler.py --dry-run",
    "precompute:build": ".venv/bin/python scripts/precompute_features.py build",
    "precompute:update": ".venv/bin/python scripts/precompute_features.py update",
    "precompute:verify": ".venv/bin/python scripts/precompute_features.py verify",
    "precompute:status": ".venv/bin/python scripts/precompute_features.py status",
    "precompute:prune-cache": ".venv/bin/python scripts/precompute_features.py prune-cache",
    "precompute:benchmark": ".venv/bin/python scripts/benchmark_precompute.py",
    "workspace:check": ".venv/bin/python scripts/check_ruipan_workspace.py",
    "mac:dmg": "zsh scripts/build_macos_dmg.sh"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@xyflow/react": "^12.11.2",
    "drizzle-orm": "0.45.2",
    "klinecharts": "^10.0.0",
    "lucide-react": "^1.25.0",
    "monaco-editor": "^0.55.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
