# Copy this file to ../.env.ai and fill it tomorrow. Never commit .env.ai.

# Option A: a local Ollama service.
QUANTWEAVE_AI_PROVIDER=ollama
QUANTWEAVE_AI_BASE_URL=http://127.0.0.1:11434
QUANTWEAVE_AI_MODEL=qwen2.5:7b

# Option B: DeepSeek API. Uncomment and replace the key in your local .env.ai only.
# QUANTWEAVE_AI_PROVIDER=deepseek
# QUANTWEAVE_AI_BASE_URL=https://api.deepseek.com
# QUANTWEAVE_AI_MODEL=deepseek-v4-flash
# QUANTWEAVE_AI_API_KEY=replace-me
# QUANTWEAVE_DEEPSEEK_THINKING=disabled

# Option C: another OpenAI-compatible API. Uncomment and replace the values.
# QUANTWEAVE_AI_PROVIDER=openai_compatible
# QUANTWEAVE_AI_BASE_URL=https://api.example.com/v1
# QUANTWEAVE_AI_MODEL=your-model-name
# QUANTWEAVE_AI_API_KEY=replace-me

# Optional read-only JSON sources. Remote sources must use HTTPS.
# token_env names an environment variable; the secret itself stays outside JSON.
QUANTWEAVE_EXTERNAL_DATA_SOURCES='[]'
# QUANTWEAVE_EXTERNAL_DATA_SOURCES='[{"id":"macro","name":"宏观数据","url":"https://data.example.com/latest","token_env":"MACRO_DATA_TOKEN"}]'
# MACRO_DATA_TOKEN=replace-me
